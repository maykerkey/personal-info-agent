# 服务端口（默认 8787）
PORT=8787

# ---------- 数据存储 ----------
# 本地开发：使用嵌入式数据库（默认，零配置）
DATABASE_URL=file:data/info.db
# 云端存储（推荐 Turso / libSQL）：换成你的数据库地址，例如
# DATABASE_URL=libsql://personal-info-agent-xxxx.turso.io
DATABASE_AUTH_TOKEN=

# ---------- 大模型（OpenAI 或兼容服务） ----------
OPENAI_API_KEY=
# 兼容服务可改 Base URL，例如 DeepSeek: https://api.deepseek.com/v1
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ---------- 访问保护（可选，上线后强烈建议设置） ----------
APP_PASSWORD=
# 用于签名登录令牌的密钥，留空则每次重启自动生成
APP_SECRET=

# ---------- 其他 ----------
APP_TIMEZONE=Asia/Shanghai
